{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layout-configurator.local/schemas/layout_result.schema.json",
  "title": "Legacy rectangles or versioned exact orthogonal result geometry",
  "oneOf": [{"$ref": "#/$defs/legacy"}, {"$ref": "#/$defs/versioned"}],
  "$defs": {
    "variant": {"type": "integer", "minimum": 1},
    "objective": {"type": ["integer", "null"]},
    "legacy": {
      "type": "object", "additionalProperties": false, "required": ["variant", "rooms"],
      "properties": {"variant": {"$ref": "#/$defs/variant"}, "objective_value": {"$ref": "#/$defs/objective"}, "rooms": {"$ref": "#/$defs/rectRooms"}}
    },
    "versioned": {
      "type": "object", "additionalProperties": false, "required": ["variant", "rooms", "geometry_version", "units"],
      "properties": {
        "variant": {"$ref": "#/$defs/variant"}, "objective_value": {"$ref": "#/$defs/objective"},
        "geometry_version": {"const": "0.2"}, "units": {"const": "mm"},
        "rooms": {"type": "object", "propertyNames": {"type": "string", "pattern": "\\S"}, "additionalProperties": {"oneOf": [{"$ref": "#/$defs/rect"}, {"$ref": "#/$defs/orthogonal"}]}}
      }
    },
    "rectRooms": {"type": "object", "propertyNames": {"type": "string", "pattern": "\\S"}, "additionalProperties": {"$ref": "#/$defs/rect"}},
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "area_m2": {"type": "number", "exclusiveMinimum": 0}}
    },
    "orthogonal": {
      "type": "object", "additionalProperties": false, "required": ["kind", "units", "vertices"],
      "properties": {
        "kind": {"const": "orthogonal"}, "units": {"const": "mm"}, "area_m2": {"type": "number", "exclusiveMinimum": 0},
        "vertices": {"type": "array", "minItems": 4, "maxItems": 257, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
      }
    }
  }
}
