{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layout-configurator.local/schemas/facility_connections.schema.json",
  "title": "Declared facility blocks and service-zone links 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["facility_blocks", "service_zone_links"],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[^/\\s]+$"},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["level", "zone_id"],
                 "properties": {"level": {"type": "integer"}, "zone_id": {"$ref": "#/$defs/id"}}}
  },
  "properties": {
    "facility_blocks": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "zones"], "properties": {
        "id": {"$ref": "#/$defs/id"},
        "zones": {"type": "object", "minProperties": 2, "propertyNames": {"pattern": "^-?[0-9]+$"},
                  "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true,
                                           "items": {"$ref": "#/$defs/id"}}}
      }}},
    "service_zone_links": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "via"], "properties": {
        "id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/endpoint"}, "to": {"$ref": "#/$defs/endpoint"},
        "via": {"$ref": "#/$defs/id"}, "minimum_clear_width_mm": {"type": "number", "exclusiveMinimum": 0},
        "required": {"type": "boolean"}
      }}}
  }
}
