<?xml version="1.0" encoding="utf-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS"
     xmlns:xs="http://www.w3.org/2001/XMLSchema"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <info>
    <title>Layout Configurator baseline information requirements</title>
    <version>0.1</version>
    <description>Checks the properties emitted by the deterministic layout exporter.</description>
    <author>layout-configurator@example.com</author>
    <purpose>Exchange and coordination baseline</purpose>
  </info>
  <specifications>
    <specification name="Every generated space has layout properties" ifcVersion="IFC4">
      <applicability>
        <entity>
          <name><simpleValue>IFCSPACE</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCLABEL" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutRoom</simpleValue></propertySet>
          <baseName><simpleValue>RoomType</simpleValue></baseName>
        </property>
        <property dataType="IFCREAL" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutRoom</simpleValue></propertySet>
          <baseName><simpleValue>TargetAreaM2</simpleValue></baseName>
        </property>
        <property dataType="IFCBOOLEAN" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutRoom</simpleValue></propertySet>
          <baseName><simpleValue>NeedsDaylight</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
    <specification name="Every generated wall has layout properties and material" ifcVersion="IFC4">
      <applicability>
        <entity>
          <name><simpleValue>IFCWALL</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCREAL" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutWall</simpleValue></propertySet>
          <baseName><simpleValue>ThicknessMm</simpleValue></baseName>
        </property>
        <material cardinality="required">
          <value><simpleValue>Generic partition wall</simpleValue></value>
        </material>
      </requirements>
    </specification>
    <specification name="Every generated door has layout properties and material" ifcVersion="IFC4">
      <applicability>
        <entity>
          <name><simpleValue>IFCDOOR</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCREAL" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutDoor</simpleValue></propertySet>
          <baseName><simpleValue>ClearWidthMm</simpleValue></baseName>
        </property>
        <material cardinality="required">
          <value><simpleValue>Generic internal door</simpleValue></value>
        </material>
      </requirements>
    </specification>
    <specification name="Every generated window has layout properties and material" ifcVersion="IFC4">
      <applicability>
        <entity>
          <name><simpleValue>IFCWINDOW</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCREAL" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutWindow</simpleValue></propertySet>
          <baseName><simpleValue>ClearWidthMm</simpleValue></baseName>
        </property>
        <material cardinality="required">
          <value><simpleValue>Generic window</simpleValue></value>
        </material>
      </requirements>
    </specification>
    <specification name="Every generated opening has layout properties" ifcVersion="IFC4">
      <applicability>
        <entity>
          <name><simpleValue>IFCOPENINGELEMENT</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCLABEL" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutOpening</simpleValue></propertySet>
          <baseName><simpleValue>OpeningKind</simpleValue></baseName>
        </property>
        <property dataType="IFCREAL" cardinality="required">
          <propertySet><simpleValue>Pset_LayoutOpening</simpleValue></propertySet>
          <baseName><simpleValue>ClearWidthMm</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
  </specifications>
</ids>
